{
  "name": "@origin-ai/xhe-session-title",
  "description": "Log-backed session title service and provider registry for the Xee Harness Enhanced",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/xhe.git",
    "directory": "packages/session/session-title"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/xhe-brand": "workspace:^",
    "@origin-ai/xhe-invariants": "workspace:^",
    "@origin-ai/xhe-llm": "workspace:^",
    "@origin-ai/xhe-session": "workspace:^",
    "@origin-ai/xhe-session-projection": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@origin-ai/xhe-brand": "workspace:^",
    "@origin-ai/xhe-invariants": "workspace:^",
    "@origin-ai/xhe-llm": "workspace:^",
    "@origin-ai/xhe-session": "workspace:^",
    "@origin-ai/xhe-session-persistence-jsonl": "workspace:^",
    "@origin-ai/xhe-session-persistence-sqlite": "workspace:^",
    "@origin-ai/xhe-session-projection": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
}
