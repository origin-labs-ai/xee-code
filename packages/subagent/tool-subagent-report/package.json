{
  "name": "@origin-ai/cf-tool-subagent-report",
  "description": "Child-scoped report tool over ctx.subagents continuations",
  "version": "0.1.1-rc.2",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
