    "@deepseek-ai/cordis": "workspace:^"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@origin-ai/cf-agent": "workspace:^",
    "@origin-ai/cf-agent-loop": "workspace:^",
    "@origin-ai/cf-agent-loop-testkit": "workspace:^",
    "@origin-ai/cf-invariants": "workspace:^",
    "@origin-ai/cf-llm": "workspace:^",
    "@origin-ai/cf-session": "workspace:^",
    "@origin-ai/cf-session-persistence": "workspace:^",
    "@origin-ai/cf-session-persistence-jsonl": "workspace:^",
    "@origin-ai/cf-subagent": "workspace:^",
    "@origin-ai/cf-subagent-spawn-in-process": "workspace:^",
    "@origin-ai/cf-system-prompt": "workspace:^",
    "@origin-ai/cf-tool-subagent-control": "workspace:^",
    "@origin-ai/cf-tools": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
