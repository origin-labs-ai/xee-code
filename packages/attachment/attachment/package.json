  },
  "files": ["lib/index.js", "lib/invariant.js", "lib/types/**/*.js", "lib/types/**/*.d.ts"],
  "license": "MIT",
  "peerDependencies": {
    "@origin-ai/xhe-brand": "workspace:^",
    "@origin-ai/xhe-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  },
  "devDependencies": {
    "@origin-ai/xhe-brand": "workspace:^",
    "@origin-ai/xhe-invariants": "workspace:^",
    "@deepseek-ai/cordis": "workspace:^"
  }
